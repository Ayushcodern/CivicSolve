# ============================================================
# CivicSolve — Local Development Environment Variables
# ============================================================
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env
# ============================================================

# ── PostgreSQL + PostGIS ─────────────────────────────────────
POSTGRES_DB=civicsolve                # Database name
POSTGRES_USER=postgres                # Database superuser
POSTGRES_PASSWORD=postgres            # Database password (change in production!)
POSTGRES_HOST=localhost               # Host — use 'postgres' inside Docker network
POSTGRES_PORT=5432                    # Default PostgreSQL port

# ── Spring Boot Backend ──────────────────────────────────────
SERVER_PORT=8080                      # Backend API port

# ── JWT Authentication ───────────────────────────────────────
JWT_SECRET=civicsolve_super_secret_jwt_key_2026_at_least_256_bits_long   # Min 256-bit key (change in production!)
JWT_EXPIRATION_MS=86400000            # Token TTL: 24 hours (in milliseconds)

# ── FastAPI AI Microservice ──────────────────────────────────
AI_SERVICE_URL=http://fastapi-ai:8000 # Internal Docker URL for Spring Boot → FastAPI calls
AI_PORT=8000                          # Port the AI service listens on

# ── Vite React Frontend ─────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8080/api/v1   # Frontend → Backend API base URL

# -- OpenAI API (CivicSolve Chatbot) -------------------------
OPENAI_API_KEY=sk-your-openai-api-key-here       # Get from https://platform.openai.com/api-keys

# -- AI service URL (for frontend to reach chatbot) -----------
VITE_AI_SERVICE_URL=http://localhost:8000        # Frontend -> AI service URL
